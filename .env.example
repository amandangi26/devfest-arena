# ==============================================================================
# DEVFEST RANCHI 2026 — LIVE INTERACTIVE GAME ENGINE ENVIRONMENT CONFIGURATION
# Venue: Radisson Blu, Ranchi | Target Scale: 800+ Live Attendees
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Cryptographic secret for signing session cookies (minimum 32 characters in production)
SESSION_SECRET=change-this-to-a-cryptographically-secure-random-32-char-string

# Master key required to access Operator Cockpit (/admin) and administrative APIs
ADMIN_API_KEY=devfest-admin-2026
ADMIN_EMAIL=admin@devfest.in
ADMIN_PASSWORD=change-in-production

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE CONFIGURATION (SERVER-SIDE)
# ------------------------------------------------------------------------------
# Leave empty to automatically run in high-speed, offline-resilient MemoryStore mode
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. FRONTEND CLIENT CONFIGURATION (VITE)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 4. EVENT METADATA
# ------------------------------------------------------------------------------
EVENT_ID=devfest-ranchi-2026
VENUE_NAME="Radisson Blu, Ranchi"
EVENT_DATE="2026-10-31"
TARGET_ATTENDEE_CAPACITY=800

