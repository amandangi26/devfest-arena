# ==============================================================================
# DEVFEST RANCHI 2026 — LIVE INTERACTIVE GAME ENGINE ENVIRONMENT CONFIGURATION
# Venue: Radisson Blu, Ranchi | Target Scale: 800+ Live Attendees
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Node.js / Express game engine server
PORT=3001

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Cryptographic secret for signing session cookies (minimum 32 characters in production)
SESSION_SECRET=devfest-ranchi-2026-super-secure-session-key-replace-in-production-min32chars

# Secret master key required to access the Operator Cockpit (/admin) and administrative APIs
# Used in the Admin UI and as 'x-admin-key' HTTP header
ADMIN_API_KEY=devfest-admin-2026
ADMIN_EMAIL=admin@devfest.in
ADMIN_PASSWORD=devfest-admin-2026

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE CONFIGURATION (SERVER-SIDE)
# ------------------------------------------------------------------------------
# NOTE: If SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are left empty, the engine
# automatically falls back to the high-speed in-memory repository (MemoryStore),
# allowing instant offline development, zero-config local testing, and Wi-Fi resilience.

# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (secret key with full schema privileges for server operations)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Anonymous Public Key (optional server reference)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. FRONTEND CLIENT CONFIGURATION (VITE)
# ------------------------------------------------------------------------------
# Optional public client variables for Vite browser bundling (prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 4. EVENT METADATA
# ------------------------------------------------------------------------------
EVENT_ID=devfest-ranchi-2026
VENUE_NAME="Radisson Blu, Ranchi"
EVENT_DATE="2026-10-31"
TARGET_ATTENDEE_CAPACITY=800
